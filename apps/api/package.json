{
  "name": "@barakah/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint --ext .ts src/",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "activation-code": "tsx src/cli/activation-code.ts",
    "dues:generate": "tsx src/cli/generate-dues.ts",
    "constitution:load": "tsx src/cli/load-constitution.ts",
    "migrate:create": "node-pg-migrate create -m ../../db/migrations --migration-file-language sql",
    "import:convert": "tsx ../../scripts/import-sheet/convert.ts",
    "import:load": "tsx ../../scripts/import-sheet/load.ts",
    "import:verify": "tsx ../../scripts/import-sheet/verify.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "archiver": "7.0.1",
    "argon2": "^0.41.0",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.0",
    "firebase-admin": "^13.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.8.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.0",
    "pino": "^9.5.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@barakah/shared": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/archiver": "^6.0.4",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
