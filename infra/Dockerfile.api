# syntax=docker/dockerfile:1
# Build from the repository root:
#   docker buildx build -f infra/Dockerfile.api -t barakah-api:$TAG .
# Build on a dev machine or CI, never on the 8 GB host (a build can spike RAM by 1-2 GB).

# ---- Build stage ---------------------------------------------------------------------------
FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app

# Dependency manifests first, so the install layer is cached until a dependency changes.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY tsconfig.base.json .eslintrc.cjs ./
COPY packages/ packages/
COPY apps/ apps/
COPY db/ db/

RUN pnpm --filter @barakah/shared typecheck \
 && pnpm --filter @barakah/api build \
 && pnpm --filter @barakah/web build

# A self-contained production tree for the API: its real dependencies only (no dev dependencies, no
# workspace symlinks). @barakah/shared is bundled into dist/ by esbuild, so it is not needed at runtime.
RUN pnpm --filter @barakah/api deploy --prod /deploy

# ---- Production stage ----------------------------------------------------------------------
FROM node:22-alpine AS production
WORKDIR /app

ENV NODE_ENV=production \
    WEB_DIST_DIR=/app/public

COPY --from=builder /deploy/node_modules ./node_modules
COPY --from=builder /deploy/package.json ./package.json
COPY --from=builder /deploy/dist ./dist
COPY --from=builder /app/apps/web/dist ./public
COPY --from=builder /app/db/migrations ./db/migrations

# Volumes mounted at /data/files and /data/archives inherit this ownership on first use.
RUN mkdir -p /data/files /data/archives /data/status && chown -R node:node /data
USER node

EXPOSE 3000
CMD ["node", "dist/index.js"]
