{
  "name": "barakah",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit --audit-level=high",
    "format": "prettier --write .",
    "migrate": "pnpm --filter @barakah/api migrate",
    "migrate:create": "pnpm --filter @barakah/api migrate:create",
    "seed": "tsx db/seed/run.ts",
    "activation-code": "pnpm --filter @barakah/api activation-code",
    "backup:smoke": "bash scripts/backup-smoke.sh",
    "i18n:report": "node scripts/i18n-report.mjs",
    "test:db": "TEST_DATABASE_URL=postgres://barakah_migrator:barakah_migrator@localhost:5432/postgres REQUIRE_DB_TESTS=1 pnpm test",
    "perf": "PERF=1 pnpm --filter @barakah/api exec vitest run src/perf/perf.test.ts",
    "dues:generate": "pnpm --filter @barakah/api dues:generate",
    "constitution:load": "pnpm --filter @barakah/api constitution:load",
    "import:convert": "pnpm --filter @barakah/api import:convert",
    "import:load": "pnpm --filter @barakah/api import:load",
    "import:verify": "pnpm --filter @barakah/api import:verify",
    "verify-ledger": "tsx scripts/verify-ledger.ts",
    "android:release": "pnpm --filter @barakah/web android:release",
    "e2e": "tsx e2e/prepare.ts && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "otplib": "^12.0.1",
    "pg": "^8.13.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "argon2"
    ],
    "overrides": {
      "glob@>=11.0.0 <11.1.0": "^11.1.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
